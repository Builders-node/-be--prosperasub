{
  "version": 2,
  "installCommand": "npm install && npx prisma generate",
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/cron/reconcile-payments",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/reminders/subscriptions/process",
      "schedule": "0 13 * * *"
    }
  ]
}
