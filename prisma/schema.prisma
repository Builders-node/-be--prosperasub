generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum app_role {
  super_admin
  restaurant_admin
  user
}

model User {
  id              String                 @id @default(uuid())
  email           String?                @unique
  passwordHash    String?                @map("password_hash")
  name            String?
  displayName     String?                @map("display_name")
  lightningPubkey String?                @unique @map("lightning_pubkey")
  authProvider    String                 @default("email") @map("auth_provider")
  avatarUrl       String?                @map("avatar_url")
  bannedUntil     DateTime?              @map("banned_until")
  deletedAt       DateTime?              @map("deleted_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  lastLoginAt     DateTime?              @map("last_login_at")
  roles              UserRole[]
  profile            UserProfile?
  sessions           UserSession[]
  loginHistory       LoginHistory[]
  cleaningSubs       CleaningSubscription[]
  cleaningBookings   CleaningBooking[]
  notifications            UserNotification[]
  cleaningPreferences      UserCleaningPreferences?
  cleaningReminderJobs     CleaningReminderJob[]

  @@map("users")
}

model UserRole {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  role      app_role
  createdAt DateTime     @default(now()) @map("created_at")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
  @@map("user_roles")
}

model UserProfile {
  id                     String   @id @default(uuid())
  userId                 String   @unique @map("user_id")
  phone                  String?  @map("phone_number")
  telegramUsername       String?  @map("telegram_username")
  whatsapp               String?  @map("whatsapp")
  nwcConnection          String?  @map("nwc_connection")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserSession {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  refreshTokenHash String   @unique @map("refresh_token_hash")
  expiresAt        DateTime @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime @default(now()) @map("created_at")
  lastActivityAt   DateTime @default(now()) @map("last_activity_at")
  userAgent        String?  @map("user_agent")
  ipAddress        String?  @map("ip_address")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("user_sessions")
}

model LightningAuthChallenge {
  id        String   @id @default(uuid())
  k1        String   @unique
  status    String   @default("pending")
  pubkey    String?
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@map("lightning_auth_challenges")
}

model LoginHistory {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  provider  String
  ipAddress String?      @map("ip_address")
  userAgent String?      @map("user_agent")
  createdAt DateTime     @default(now()) @map("created_at")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("login_history")
}

model CleaningPackage {
  id                    String                 @id @default(uuid())
  name                  String
  description           String?
  pricePerCleaningCents Int?                   @map("price_per_cleaning_cents")
  monthlyPriceCents     Int?                   @map("monthly_price_cents")
  cleaningsPerMonth     Int                    @default(4) @map("cleanings_per_month")
  frequencyUnit         String                 @default("month") @map("frequency_unit")
  frequencyCount        Int?                   @map("frequency_count")
  customFrequencyLabel  String?                @map("custom_frequency_label")
  pricingMode           String                 @default("price_per_cleaning") @map("pricing_mode")
  isActive              Boolean                @default(true) @map("is_active")
  deletedAt             DateTime?              @map("deleted_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  subscriptions         CleaningSubscription[]

  @@index([isActive])
  @@map("cleaning_packages")
}

model CleaningAvailableSlot {
  id              String            @id @default(uuid())
  date            String
  startTime       String            @map("start_time")
  endTime         String            @map("end_time")
  maxBookings     Int               @default(1) @map("max_bookings")
  currentBookings Int               @default(0) @map("current_bookings")
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime?         @updatedAt @map("updated_at")
  bookings        CleaningBooking[]

  @@index([date, isActive])
  @@map("cleaning_available_slots")
}

model CleaningSubscription {
  id                  String            @id @default(uuid())
  userId              String?           @map("user_id")
  clientId            String?           @map("client_id")
  packageId           String            @map("package_id")
  isActive            Boolean           @default(true) @map("is_active")
  startDate           String?           @map("start_date")
  endDate             String?           @map("end_date")
  billingPeriodMonths Int               @default(1) @map("billing_period_months")
  monthlyPriceCents   Int               @default(0) @map("monthly_price_cents")
  totalPriceCents     Int               @default(0) @map("total_price_cents")
  serviceStartDate    String?           @map("service_start_date")
  serviceEndDate      String?           @map("service_end_date")
  paidUntil           String?           @map("paid_until")
  cleaningsRemaining  Int?              @map("cleanings_remaining")
  paymentStatus       String            @default("pending") @map("payment_status")
  subscriptionStatus  String            @default("active") @map("subscription_status")
  paymentMethod       String?           @map("payment_method")
  paymentReference    String?           @map("payment_reference")
  recurringDayOfWeek  Int?              @map("recurring_day_of_week")
  recurringTime       String?           @map("recurring_time")
  apartmentNote       String?           @map("apartment_note")
  adminNotes          String?           @map("admin_notes")
  deletedAt           DateTime?         @map("deleted_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  user                User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  package             CleaningPackage   @relation(fields: [packageId], references: [id], onDelete: Restrict)
  bookings            CleaningBooking[]

  @@index([userId, isActive])
  @@index([paidUntil, subscriptionStatus])
  @@map("cleaning_subscriptions")
}

model CleaningClient {
  id                 String                 @id @default(uuid())
  companyName        String                 @map("company_name")
  contactPerson      String?                @map("contact_person")
  email              String?
  phone              String?
  location           String
  serviceType        String?                @map("service_type")
  notes              String?
  internalAdminNotes String?                @map("internal_admin_notes")
  invoicePreferences String?                @map("invoice_preferences")
  startDate          DateTime               @map("start_date")
  status             String                 @default("ACTIVE")
  isPrivate          Boolean                @default(true) @map("is_private")
  visibility         String                 @default("admin_only")
  clientType         String                 @default("custom_cleaning_client") @map("client_type")
  deletedAt          DateTime?              @map("deleted_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  customPlans        CleaningCustomPlan[]
  bookings           CleaningBooking[]
  recurringSchedules CleaningRecurringSchedule[]
  checklistTemplates CleaningChecklistTemplate[]
  completionReports  CleaningCompletionReport[]

  @@index([status])
  @@index([visibility, isPrivate])
  @@map("cleaning_clients")
}

model CleaningCustomPlan {
  id                         String                       @id @default(uuid())
  clientId                   String                       @map("client_id")
  planName                   String                       @map("plan_name")
  customPriceCents           Int                          @map("custom_price_cents")
  monthlyPriceCents          Int?                         @map("monthly_price_cents")
  pricePerCleaningCents      Int?                         @map("price_per_cleaning_cents")
  frequencyUnit              String                       @default("custom") @map("frequency_unit")
  frequencyCount             Int?                         @map("frequency_count")
  customFrequencyLabel       String?                      @map("custom_frequency_label")
  pricingMode                String                       @default("custom_manual") @map("pricing_mode")
  billingType                String                       @default("CUSTOM") @map("billing_type")
  monthlyInvoice             Boolean                      @default(false) @map("monthly_invoice")
  paymentTiming              String                       @default("CUSTOM_TERMS") @map("payment_timing")
  customTerms                String?                      @map("custom_terms")
  serviceFrequency           String?                      @map("service_frequency")
  daysOfWeek                 String[]                     @default([]) @map("days_of_week")
  deepCleaningAddOn          Boolean                      @default(false) @map("deep_cleaning_add_on")
  estimatedMonthlyTotalCents Int?                         @map("estimated_monthly_total_cents")
  customChecklist            String[]                     @default([]) @map("custom_checklist")
  status                     String                       @default("ACTIVE")
  isPrivate                  Boolean                      @default(true) @map("is_private")
  visibility                 String                       @default("admin_only")
  clientType                 String                       @default("custom_cleaning_client") @map("client_type")
  createdAt                  DateTime                     @default(now()) @map("created_at")
  updatedAt                  DateTime                     @updatedAt @map("updated_at")
  client                     CleaningClient               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  recurringSchedules         CleaningRecurringSchedule[]
  bookings                   CleaningBooking[]
  checklistTemplates         CleaningChecklistTemplate[]
  completionReports          CleaningCompletionReport[]

  @@index([clientId, status])
  @@index([visibility, isPrivate])
  @@map("cleaning_custom_plans")
}

model CleaningRecurringSchedule {
  id                     String                 @id @default(uuid())
  clientId               String                 @map("client_id")
  customPlanId           String                 @map("custom_plan_id")
  startDate              DateTime               @map("start_date")
  endDate                DateTime?              @map("end_date")
  daysOfWeek             String[]               @default([]) @map("days_of_week")
  preferredStartTime     String                 @map("preferred_start_time")
  preferredEndTime       String                 @map("preferred_end_time")
  assignedCleaner        String?                @map("assigned_cleaner")
  location               String
  serviceDurationMinutes Int                    @default(120) @map("service_duration_minutes")
  repeatFrequency        String                 @default("weekly") @map("repeat_frequency")
  status                 String                 @default("ACTIVE")
  pausedAt               DateTime?              @map("paused_at")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  client                 CleaningClient         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  customPlan             CleaningCustomPlan     @relation(fields: [customPlanId], references: [id], onDelete: Cascade)
  bookings               CleaningBooking[]

  @@index([clientId, status])
  @@index([customPlanId, status])
  @@map("cleaning_recurring_schedules")
}

model CleaningChecklistTemplate {
  id           String                @id @default(uuid())
  clientId     String                @map("client_id")
  customPlanId String                @map("custom_plan_id")
  templateType String                @default("CUSTOM") @map("template_type")
  name         String
  items        String[]              @default([])
  isActive     Boolean               @default(true) @map("is_active")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  client       CleaningClient        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  customPlan   CleaningCustomPlan    @relation(fields: [customPlanId], references: [id], onDelete: Cascade)
  bookings     CleaningBooking[]

  @@index([customPlanId, isActive])
  @@map("cleaning_checklist_templates")
}

model CleaningBooking {
  id             String                @id @default(uuid())
  userId         String                @map("user_id")
  subscriptionId String?               @map("subscription_id")
  cleaningSubscriptionId String?       @map("cleaning_subscription_id")
  clientId       String?               @map("client_id")
  customPlanId   String?               @map("custom_plan_id")
  recurringScheduleId String?          @map("recurring_schedule_id")
  checklistTemplateId String?          @map("checklist_template_id")
  slotId         String                @map("slot_id")
  status         String                @default("BOOKED")
  notes          String?
  location       String?
  assignedCleaner String?              @map("assigned_cleaner")
  serviceDurationMinutes Int?          @map("service_duration_minutes")
  source         String?
  isPrivate      Boolean               @default(false) @map("is_private")
  visibility     String?
  clientType     String?               @map("client_type")
  googleCalendarEventId String?        @map("google_calendar_event_id")
  // Which calendar the event above lives on — an event id only resolves on its own.
  googleCalendarId String?             @map("google_calendar_id")
  googleCalendarEventLink String?      @map("google_calendar_event_link")
  googleCalendarSyncedAt DateTime?     @map("google_calendar_synced_at")
  googleCalendarSyncStatus String      @default("pending") @map("google_calendar_sync_status")
  googleCalendarSyncError String?      @map("google_calendar_sync_error")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   CleaningSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  slot           CleaningAvailableSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  client         CleaningClient?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  customPlan     CleaningCustomPlan?   @relation(fields: [customPlanId], references: [id], onDelete: Cascade)
  recurringSchedule CleaningRecurringSchedule? @relation(fields: [recurringScheduleId], references: [id], onDelete: SetNull)
  checklistTemplate CleaningChecklistTemplate? @relation(fields: [checklistTemplateId], references: [id], onDelete: SetNull)
  completionReport CleaningCompletionReport?

  @@index([userId, status])
  @@index([clientId, status])
  @@index([recurringScheduleId, status])
  @@index([googleCalendarSyncStatus])
  @@map("cleaning_bookings")
}

model CleaningCompletionReport {
  id                 String             @id @default(uuid())
  bookingId          String             @unique @map("booking_id")
  clientId           String?            @map("client_id")
  customPlanId       String?            @map("custom_plan_id")
  checklistCompleted String[]           @default([]) @map("checklist_completed")
  notes              String?
  photoUrl           String?            @map("photo_url")
  issueReport        String?            @map("issue_report")
  completedBy        String             @map("completed_by")
  completedAt        DateTime           @default(now()) @map("completed_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  booking            CleaningBooking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  client             CleaningClient?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  customPlan         CleaningCustomPlan? @relation(fields: [customPlanId], references: [id], onDelete: SetNull)

  @@index([clientId, completedAt])
  @@index([customPlanId, completedAt])
  @@map("cleaning_completion_reports")
}

model PaymentCheckoutSession {
  id                  String   @id @default(uuid())
  provider            String
  providerPaymentId   String   @map("provider_payment_id")
  context             String?
  serviceName         String   @map("service_name")
  clientName          String?  @map("client_name")
  clientEmail         String?  @map("client_email")
  clientPhone         String?  @map("client_phone")
  amountCents         Int?     @map("amount_cents")
  amountSats          Int?     @map("amount_sats")
  currency            String   @default("USD")
  planName            String?  @map("plan_name")
  duration            String?
  bookingId           String?  @map("booking_id")
  adminUrl            String?  @map("admin_url")
  selectedDateTime    String?  @map("selected_date_time")
  description         String?
  externalId          String?  @map("external_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([provider, providerPaymentId])
  @@index([context])
  @@map("payment_checkout_sessions")
}

model AdminPaymentNotification {
  id             String   @id @default(uuid())
  provider       String
  providerPaymentId String @map("provider_payment_id")
  serviceName    String   @map("service_name")
  clientName     String?  @map("client_name")
  clientEmail    String?  @map("client_email")
  clientPhone    String?  @map("client_phone")
  amountCents    Int?     @map("amount_cents")
  amountSats     Int?     @map("amount_sats")
  currency       String   @default("USD")
  planName       String?  @map("plan_name")
  duration       String?
  bookingId      String?  @map("booking_id")
  adminUrl       String?  @map("admin_url")
  selectedDateTime String? @map("selected_date_time")
  paymentStatus  String   @default("paid") @map("payment_status")
  paidAt         DateTime @map("paid_at")
  emailStatus    String   @default("pending") @map("email_status")
  emailSentAt    DateTime? @map("email_sent_at")
  emailError     String?  @map("email_error")
  telegramStatus String   @default("pending") @map("telegram_status")
  telegramSentAt DateTime? @map("telegram_sent_at")
  telegramError  String?  @map("telegram_error")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([provider, providerPaymentId])
  @@index([paidAt])
  @@index([emailStatus, telegramStatus])
  @@map("admin_payment_notifications")
}

model GlobalSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("global_settings")
}

model RbacRole {
  id          String               @id @default(uuid())
  slug        String               @unique
  name        String               @unique
  description String?
  status      String               @default("active")
  isSystem    Boolean              @default(false) @map("is_system")
  isAdminRole Boolean              @default(false) @map("is_admin_role")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  archivedAt  DateTime?            @map("archived_at")
  permissions RbacRolePermission[]
  users       RbacUserRole[]

  @@index([status])
  @@map("rbac_roles")
}

model RbacPermission {
  key               String               @id
  category          String
  name              String
  description       String?
  isAdminPermission Boolean              @default(false) @map("is_admin_permission")
  createdAt         DateTime             @default(now()) @map("created_at")
  rolePermissions   RbacRolePermission[]

  @@index([category])
  @@map("rbac_permissions")
}

model RbacRolePermission {
  roleId        String         @map("role_id")
  permissionKey String         @map("permission_key")
  grantedAt     DateTime       @default(now()) @map("granted_at")
  role          RbacRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    RbacPermission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@map("rbac_role_permissions")
}

model RbacUserRole {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  roleId       String    @map("role_id")
  assignedBy   String?   @map("assigned_by")
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  removedBy    String?   @map("removed_by")
  removedAt    DateTime? @map("removed_at")
  role         RbacRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([userId, removedAt])
  @@index([roleId, removedAt])
  @@map("rbac_user_roles")
}

model RbacRoleAuditLog {
  id          String   @id @default(uuid())
  action      String
  roleId      String?  @map("role_id")
  targetUserId String? @map("target_user_id")
  actorUserId String? @map("actor_user_id")
  details     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([roleId, createdAt])
  @@index([targetUserId, createdAt])
  @@map("rbac_role_audit_logs")
}

model UserCleaningPreferences {
  id                    String   @id @default(uuid())
  userId                String   @unique @map("user_id")
  reminderEnabled       Boolean  @default(true) @map("reminder_enabled")
  reminderMethod        String   @default("all") @map("reminder_method") // "all" | "email" | "in_app"
  reminderMinutesBefore Int      @default(60) @map("reminder_minutes_before")
  accessInstructions    String?  @map("access_instructions")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_cleaning_preferences")
}

model CleaningReminderJob {
  id            String    @id @default(uuid())
  bookingId     String    @map("booking_id")
  userId        String    @map("user_id")
  scheduledAt   DateTime  @map("scheduled_at")
  sentAt        DateTime? @map("sent_at")
  status        String    @default("pending") // "pending" | "sent" | "skipped" | "failed"
  methodsSent   Json?     @map("methods_sent")
  errorMessage  String?   @map("error_message")
  createdAt     DateTime  @default(now()) @map("created_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookingId, userId])
  @@index([status, scheduledAt])
  @@map("cleaning_reminder_jobs")
}

model UserNotification {
  id                String   @id @default(uuid())
  recipientUserId   String   @map("recipient_user_id")
  category          String   // "payment" | "subscription" | "booking" | "reminder" | "plan"
  type              String   // e.g. "payment_received" | "booking_created" | "booking_cancelled"
  title             String
  body              String
  isRead            Boolean  @default(false) @map("is_read")
  isArchived        Boolean  @default(false) @map("is_archived")
  relatedEntityType String?  @map("related_entity_type") // "booking" | "subscription" | "plan"
  relatedEntityId   String?  @map("related_entity_id")
  actionUrl         String?  @map("action_url")
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, isRead, isArchived])
  @@index([recipientUserId, category])
  @@map("user_notifications")
}

// ── Phase 0: domain event bus (transactional outbox) ──────────────────────────
// The backbone of the DDD migration. `EventBusService.publish` writes an
// unpublished row here (ideally in the same tx as the state change); the outbox
// dispatcher (cron) delivers to in-process handlers idempotently.
model DomainEvent {
  id            String                @id @default(uuid()) @db.Uuid
  type          String
  version       Int                   @default(1)
  occurredAt    DateTime              @default(now()) @map("occurred_at")
  subjectRef    String?               @map("subject_ref")
  correlationId String?               @map("correlation_id") @db.Uuid
  causationId   String?               @map("causation_id") @db.Uuid
  payload       Json                  @default("{}")
  publishedAt   DateTime?             @map("published_at")
  deliveries    DomainEventDelivery[]

  @@index([occurredAt])
  @@index([type])
  @@map("domain_events")
}

model DomainEventDelivery {
  eventId     String      @map("event_id") @db.Uuid
  consumer    String
  status      String      @default("delivered") // delivered | failed | dead
  attempts    Int         @default(1)
  lastError   String?     @map("last_error")
  deliveredAt DateTime    @default(now()) @map("delivered_at")
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at")
  event       DomainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, consumer])
  @@map("domain_event_deliveries")
}

// ── Phase 1: Billing domain — generic payment ledger ─────────────────────────
// Reuses the pre-existing (empty) `payments` table. One row per captured payment
// across every rail; written by BillingService.recordCaptured (idempotent on
// provider + provider_ref). Extra legacy columns (user_id, restaurant_id,
// subscription_id, amount_sats, description) stay nullable and are left unset.
model Payment {
  id          String    @id @default(uuid())
  method      String
  provider    String?
  providerRef String?   @map("provider_ref")
  amountCents Int?      @map("amount_cents")
  currency    String    @default("USD")
  status      String    @default("pending")
  subjectRef  String?   @map("subject_ref")
  metadata    Json      @default("{}")
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("payments")
}

// ── Phase 4b: Booking write side ─────────────────────────────────────────────
model Booking {
  id         String    @id @default(uuid()) @db.Uuid
  resourceId String    @map("resource_id") @db.Uuid
  providerId String?   @map("provider_id") @db.Uuid
  subjectRef String?   @map("subject_ref")
  startAt    DateTime  @map("start_at")
  endAt      DateTime  @map("end_at")
  slotKey    String    @map("slot_key")
  status     String    @default("held")   // held|confirmed|cancelled|completed|no_show|released
  orderRef   String?   @map("order_ref")
  expiresAt  DateTime? @map("expires_at")
  label      String?                        // display name (e.g. member_name for admin bookings)
  notes      String?
  googleCalendarEventId    String? @map("google_calendar_event_id")
  googleCalendarSyncStatus String? @map("google_calendar_sync_status")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("bookings")
}

model BookingWaitlist {
  id         String   @id @default(uuid()) @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  slotKey    String   @map("slot_key")
  subjectRef String?  @map("subject_ref")
  status     String   @default("waiting") // waiting|promoted|left
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([resourceId, slotKey, status])
  @@map("booking_waitlist")
}

// ── Phase 5: Order domain — transaction / saga aggregate ─────────────────────
model Order {
  id          String   @id @default(uuid()) @db.Uuid
  subjectRef  String?  @map("subject_ref")
  status      String   @default("pending_payment") // draft|pending_payment|confirmed|completed|cancelled|refunded
  amountCents Int?     @map("amount_cents")
  currency    String   @default("USD")
  lines       Json     @default("[]")
  paymentRef  String?  @map("payment_ref")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([subjectRef])
  @@index([status])
  @@map("orders")
}

// ── Phase 7: Analytics domain — event-sourced read model ─────────────────────
model AnalyticsEventCount {
  eventType String   @map("event_type")
  day       DateTime @db.Date
  count     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([eventType, day])
  @@map("analytics_event_counts")
}

// ── Phase 7b: Notification domain — intent log (pure subscriber) ─────────────
model NotificationLog {
  id         String   @id @default(uuid()) @db.Uuid
  eventType  String   @map("event_type")
  subjectRef String?  @map("subject_ref")
  channel    String   @default("inapp")
  status     String   @default("queued") // queued|sent|failed
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([subjectRef])
  @@map("notification_log")
}

// ── Phase 7: Analytics revenue projection ────────────────────────────────────
model AnalyticsRevenueDaily {
  day          DateTime @db.Date
  method       String   @default("unknown")
  revenueCents Int      @default(0) @map("revenue_cents")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@id([day, method])
  @@map("analytics_revenue_daily")
}
